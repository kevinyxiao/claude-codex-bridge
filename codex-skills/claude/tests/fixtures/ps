#!/usr/bin/env python3
"""Fixture process identities when the host sandbox denies the real ps."""

import json
import os
from pathlib import Path
import sys
import time


with open(os.environ["MCP_STUB_PS_RECORD"], "a", encoding="utf-8") as stream:
    stream.write(json.dumps(sys.argv[1:]) + "\n")
root = Path(os.environ["MCP_STUB_IDENTITIES"])
root.mkdir(parents=True, exist_ok=True)

if sys.argv[1:] == ["-axo", "pid=,pgid=,lstart="]:
    mode = os.environ.get("MCP_STUB_PS_GROUP_MODE", "matching")
    if mode == "unavailable":
        sys.exit(1)
    if mode == "malformed":
        print("unparseable process snapshot")
        sys.exit(0)
    if mode == "empty":
        sys.exit(0)
    for path in root.iterdir():
        try:
            pid = int(path.name)
            pgid = os.getpgid(pid)
            identity = path.read_text(encoding="utf-8")
        except (OSError, ValueError):
            continue
        print("%d %d %s" % (pid, pgid, identity))
        if mode == "older":
            # Keep a qualifying live member as well: every member must pass.
            print("%d %d Mon Jan  1 00:00:00 1900" % (pid + 1000000, pgid))
        elif mode == "newer":
            newer = time.asctime(time.localtime(time.time() + 86400))
            print("%d %d %s" % (pid + 1000000, pgid, newer))
        elif mode == "leader-present":
            print("%d %d %s" % (pgid, pgid, identity))
elif len(sys.argv) == 5 and sys.argv[1:4] == ["-o", "lstart=", "-p"]:
    try:
        pid = int(sys.argv[4])
        os.kill(pid, 0)
        path = root / str(pid)
        try:
            with path.open("x", encoding="utf-8") as stream:
                stream.write(time.asctime())
        except FileExistsError:
            pass
        identity = path.read_text(encoding="utf-8")
        deadline = time.monotonic() + 1
        while not identity:
            if time.monotonic() >= deadline:
                sys.exit(1)
            time.sleep(0.001)
            identity = path.read_text(encoding="utf-8")
    except (OSError, ValueError):
        sys.exit(1)
    print(identity)
else:
    sys.exit(2)
