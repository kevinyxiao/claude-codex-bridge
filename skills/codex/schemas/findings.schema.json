{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code review findings (shared by every reviewer: GPT via Codex, Opus via Claude Code)",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "assessment"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "title", "file", "line", "explanation", "suggested_fix", "confidence"],
        "properties": {
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "title": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "explanation": { "type": "string" },
          "suggested_fix": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "assessment": { "type": "string" }
  }
}
